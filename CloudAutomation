## CRIA SUBNET PUBLICA 1A ##
aws ec2 create-subnet --vpc-id vpc-0223863ff0dd27ee3 --cidr-block 10.0.1.0/24 --tag-specifications "ResourceType=subnet,Tags=[{Key=Name,Value=public-subnet-cli-1a}]"

## CRIA SUBNET PRIVADA 1A ##
aws ec2 create-subnet --vpc-id vpc-0223863ff0dd27ee3 --cidr-block 10.0.100.0/24 --tag-specifications "ResourceType=subnet,Tags=[{Key=Name,Value=private-subnet-cli-1a}]"

## CRIA UM INTERNET GATEWAY ##
aws ec2 create-internet-gateway --tag-specifications "ResourceType=internet-gateway,Tags=[{Key=Name,Value=clc16-vpc-igw}]"

## ATACHA O INTERNET GATEWAY NA VPC ##
aws ec2 attach-internet-gateway --internet-gateway-id igw-07d313f417afe7301 --vpc-id vpc-0223863ff0dd27ee3

## CRIA UMA TABELA DE ROTA PUBLICA NA CLC16-VPC ##
aws ec2 create-route-table --vpc-id vpc-0223863ff0dd27ee3 --tag-specifications "ResourceType=route-table,Tags=[{Key=Name,Value=public-rt}]"

## ADICIONA ROTA PARA O IGW NA TABELA DE ROTA PUBLICA ##
aws ec2 create-route --route-table-id rtb-00f37be1489243d1d --destination-cidr-block 0.0.0.0/0 --gateway-id igw-07d313f417afe7301

## ASSOCIA A TABELA DE ROTA COM A SUBNET PUBLICA 1A ##
aws ec2 associate-route-table --route-table-id rtb-00f37be1489243d1d --subnet-id subnet-0e14d6107ac56c6d4

## CRIA UM ELASTIC IP PARA USAR NA NAT GATEWAY 1A ##
aws ec2 allocate-address

## CRIA UM NAT GATEWAY NA SUBNET-PUBLICA-1A ##
aws ec2 create-nat-gateway --subnet-id subnet-0e14d6107ac56c6d4 --allocation-id eipalloc-051519a82eca24103

## CRIA UMA TABELA DE ROTA PRIVADA NA CLC16-VPC ##
aws ec2 create-route-table --vpc-id vpc-0223863ff0dd27ee3 --tag-specifications "ResourceType=route-table,Tags=[{Key=Name,Value=rt-private-1a}]"

## ADICIONA ROTA PARA O NATGW NA TABELA DE ROTA PRIVADA ##
aws ec2 create-route --route-table-id rtb-0b3664c2494f48088 --destination-cidr-block 0.0.0.0/0 --nat-gateway-id nat-027822325380874a3

## ASSOCIA A TABELA DE ROTA PRIVADA COM A SUBNET PRIVADA 1A ##
aws ec2 associate-route-table --route-table-id rtb-0b3664c2494f48088 --subnet-id subnet-0282d917f7180d4de

